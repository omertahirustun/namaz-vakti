+    /**
+     * Places a live Chronometer (static in rn_widget.xml, so no nested RemoteViews or app resources
+     * that some OEM launchers reject) over the first TextWidget that has `countdownTo`. The launcher
+     * ticks it by itself, so the countdown runs every second without re-rendering the widget.
+     * Positioned with left/top padding and a fixed size only: if the host is narrower than the
+     * reported widget width, right padding could squeeze the view to zero width.
+     */
+    private void addCountdowns(RemoteViews remoteWidgetView, WidgetWithViews widgetWithViews) {
+        remoteWidgetView.setViewVisibility(R.id.rn_widget_countdown, View.GONE);
+        remoteWidgetView.setViewVisibility(R.id.rn_widget_countdown_flat, View.GONE);
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.N) {
+            return;
+        }
+        ViewGroup rootView = (ViewGroup) widgetWithViews.getRootView();
+        List<TextView> countdownViews = new ArrayList<>();
+        findCountdownViews(rootView, countdownViews);
+        if (countdownViews.isEmpty()) {
+            return;
+        }
+        TextView textView = countdownViews.get(0);
+        TextWidget.Countdown countdown = (TextWidget.Countdown) textView.getTag();
+        // Shadows can't be set through RemoteViews, so the layout has a shadowed and a flat Chronometer;
+        // use the one matching the placeholder's text shadow.
+        int viewId = textView.getShadowRadius() > 0 ? R.id.rn_widget_countdown : R.id.rn_widget_countdown_flat;
+        Rect bounds = new Rect();
+        textView.getDrawingRect(bounds);
+        rootView.offsetDescendantRectToMyCoords(textView, bounds);
+
+        // The Chronometer uses the system font, which OEMs (Samsung, Xiaomi...) replace with wider ones
+        // than the font the placeholder was measured with. Give it the widest box centered on the
+        // placeholder and only a minimum height, so the last digit is never clipped.
+        int rootWidth = rootView.getMeasuredWidth();
+        int centerX = bounds.centerX();
+        int halfWidth = Math.max(Math.min(centerX, rootWidth - centerX), bounds.width() / 2);
+        remoteWidgetView.setViewPadding(R.id.rn_widget_countdown_positioner, Math.max(0, centerX - halfWidth), bounds.top, 0, 0);
+        remoteWidgetView.setInt(viewId, "setWidth", halfWidth * 2);
+        remoteWidgetView.setInt(viewId, "setMinHeight", bounds.height());
+        remoteWidgetView.setTextColor(viewId, countdown.color);
+        remoteWidgetView.setTextViewTextSize(viewId, countdown.fontSizeUnit, countdown.fontSize);
+        long base = SystemClock.elapsedRealtime() + (countdown.countdownTo - System.currentTimeMillis());
+        remoteWidgetView.setChronometer(viewId, base, countdown.format, true);
+        remoteWidgetView.setChronometerCountDown(viewId, true);
+        remoteWidgetView.setViewVisibility(viewId, View.VISIBLE);
+        Log.d("RNWidgetCountdown", "widget=" + widgetName + " root=" + rootWidth + "x" + rootView.getMeasuredHeight()
+            + " text=" + bounds + " box=" + Math.max(0, centerX - halfWidth) + "," + bounds.top + " w=" + (halfWidth * 2)
+            + " left=" + (countdown.countdownTo - System.currentTimeMillis()) + "ms format=" + countdown.format);
+    }
