+    private static void findCountdownViews(View view, List<TextView> result) {
+        if (view instanceof TextView && view.getTag() instanceof TextWidget.Countdown) {
+            result.add((TextView) view);
+        } else if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) {
+                findCountdownViews(group.getChildAt(i), result);
+            }
+        }
+    }
