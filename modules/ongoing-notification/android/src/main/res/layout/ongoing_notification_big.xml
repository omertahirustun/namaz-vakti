<?xml version="1.0" encoding="utf-8"?>
<!-- Kalıcı bildirimin açık hâli: üstte geri sayım satırı (ongoing_notification.xml ile aynı), altında günün
     altı vakti. Sıradaki vakit çerçeveli kutuda (drawable/ongoing_active), geçmiş vakitler soluk. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <include layout="@layout/ongoing_notification" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/ongoing_cell0"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="2dp"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingVertical="5dp">

      <TextView
        android:id="@+id/ongoing_name0"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/ongoing_time0"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/ongoing_cell1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="2dp"
      android:layout_weight="1"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingVertical="5dp">

      <TextView
        android:id="@+id/ongoing_name1"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/ongoing_time1"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/ongoing_cell2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="2dp"
      android:layout_weight="1"
