{
  "expo": {
    "name": "Namaz Vakti",
    "slug": "namaz-vakti",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EEF7F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.omertahirustun.namazvakti",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Bulunduğun yere göre namaz vakitlerini ve kıble yönünü hesaplamak için konuma ihtiyaç duyulur."
      }
    },
    "android": {
      "package": "com.omertahirustun.namazvakti",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bulunduğun yere göre namaz vakitlerini ve kıble yönünü hesaplamak için konuma ihtiyaç duyulur."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A8C77"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "659d5431-ea8e-4934-9cad-be733a1ed3f8"
      }
    },
    "owner": "sezeryanpatates"
  }
}
