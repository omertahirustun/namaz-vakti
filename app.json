{
  "expo": {
    "name": "Namaz Vakti",
    "slug": "namaz-vakti",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E6EBF7",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.omertahirustun.namazvakti",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Bulunduğun yere göre namaz vakitlerini ve kıble yönünü hesaplamak için konuma ihtiyaç duyulur."
      }
    },
    "android": {
      "package": "com.omertahirustun.namazvakti",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 21,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bulunduğun yere göre namaz vakitlerini ve kıble yönünü hesaplamak için konuma ihtiyaç duyulur."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A8C77",
          "sounds": ["./assets/sounds/vakit.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "PrayerTimes",
              "label": "Namaz Vakitleri",
              "description": "Sıradaki vakit ve günün vakitleri, seçili temayla",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget/preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PrayerCountdown",
              "label": "Vakte Kalan",
              "description": "Sıradaki vakte kalan süre (saat:dakika)",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget/preview-countdown.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "659d5431-ea8e-4934-9cad-be733a1ed3f8"
      }
    },
    "owner": "sezeryanpatates"
  }
}
