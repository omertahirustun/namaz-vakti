{
  "expo": {
    "name": "Haydi Namaza",
    "slug": "namaz-vakti",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E6EBF7",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adezyonmedya.haydinamaza",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Bulunduğun yere göre namaz vakitlerini ve kıble yönünü hesaplamak için konuma ihtiyaç duyulur.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.adezyonmedya.haydinamaza"
        ]
      }
    },
    "android": {
      "package": "com.adezyonmedya.haydinamaza",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 27,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6EC"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bulunduğun yere göre namaz vakitlerini ve kıble yönünü hesaplamak için konuma ihtiyaç duyulur."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#243AA2",
          "sounds": [
            "./assets/sounds/vakit.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FAF6EC"
        }
      ],
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "PrayerTimes",
              "label": "Namaz Vakitleri",
              "description": "Sıradaki vakit ve günün vakitleri, seçili temayla",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget/preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PrayerCountdown",
              "label": "Vakte Kalan",
              "description": "Sıradaki vakte kalan süre (saat:dakika)",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget/preview-countdown.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PrayerStrip",
              "label": "Vakit Şeridi",
              "description": "İnce uzun yatay: sıradaki vakte kalan süre ve yan yana günün vakitleri",
              "minWidth": "250dp",
              "minHeight": "50dp",
              "targetCellWidth": 6,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget/preview-strip.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-background-task",
      "@bacons/apple-targets"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "659d5431-ea8e-4934-9cad-be733a1ed3f8"
      }
    },
    "owner": "sezeryanpatates"
  }
}
